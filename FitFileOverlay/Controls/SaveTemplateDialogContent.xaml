<UserControl x:Class="FitFileOverlay.Controls.SaveTemplateDialogContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FitFileOverlay.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:SaveTemplateDialogContent, IsDesignTimeCreatable=False}"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid Width="300">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:TextBlock Grid.Column="0" 
                      Margin="0,0,5,0"
                      Text="Name:"
                      VerticalAlignment="Center" />
        <ui:TextBox Grid.Column="1" 
                    Text="{Binding FileName}" />
    </Grid>
</UserControl>
