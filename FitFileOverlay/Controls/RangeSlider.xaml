<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FitFileOverlay.Controls">
    <Style x:Key="UiSliderThumbStyle"
           TargetType="{x:Type Thumb}">
        <Setter Property="Height"
                Value="20" />
        <Setter Property="Width"
                Value="20" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="Foreground"
                Value="{DynamicResource SliderThumbBackground}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Background"
                Value="{DynamicResource SliderOuterThumbBackground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16"
                            Width="20">
                        <Ellipse x:Name="Ellipse"
                                 Width="12"
                                 Height="12"
                                 Fill="{TemplateBinding Foreground}"
                                 Stroke="Transparent"
                                 StrokeThickness="0" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate TargetType="local:RangeSlider"
                     x:Key="RangeSliderTemplate">
        <Border BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Background="{TemplateBinding Background}"
                Width="{TemplateBinding Width}"
                Height="{TemplateBinding Height}"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
            <Grid Name="PART_SliderContainer"
                  Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Name="PART_StartArea"
                        IsHitTestVisible="False" />

                <Border Grid.Column="2"
                        Name="PART_EndArea"
                        IsHitTestVisible="False" />
                <Border x:Name="PART_TrackBackground"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource SliderTrackFill}"
                        Height="4"
                        Margin="0"
                        CornerRadius="2"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False" />
                <Border x:Name="PART_SelectedTrack"
                        Grid.Column="1"
                        Background="{DynamicResource AccentButtonBackground}"
                        Height="5"
                        Margin="0"
                        CornerRadius="2"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False" />
                <Thumb Name="PART_StartThumb"
                       Grid.Column="0"
                       HorizontalAlignment="Left"
                       Style="{TemplateBinding StartThumbStyle}"
                       ToolTip="{TemplateBinding StartThumbToolTip}" />

                <Thumb Name="PART_EndThumb"
                       Grid.Column="2"
                       HorizontalAlignment="Left"
                       Style="{TemplateBinding EndThumbStyle}"
                       ToolTip="{TemplateBinding EndThumbToolTip}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter TargetName="PART_TrackBackground"
                        Property="Background"
                        Value="{DynamicResource SliderTrackFillPointerOver}" />
                <Setter TargetName="PART_StartThumb"
                        Property="Foreground"
                        Value="{DynamicResource SliderThumbBackgroundPointerOver}" />
                <Setter TargetName="PART_EndThumb"
                        Property="Foreground"
                        Value="{DynamicResource SliderThumbBackgroundPointerOver}" />
            </Trigger>
            <Trigger Property="IsReadOnly"
                     Value="True">
                <Setter TargetName="PART_StartThumb"
                        Property="IsEnabled"
                        Value="False" />
                <Setter TargetName="PART_EndThumb"
                        Property="IsEnabled"
                        Value="False" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type local:RangeSlider}">
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="StartThumbStyle"
                Value="{StaticResource UiSliderThumbStyle}" />
        <Setter Property="EndThumbStyle"
                Value="{StaticResource UiSliderThumbStyle}" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Template"
                Value="{StaticResource RangeSliderTemplate}" />
        <Setter Property="MinWidth"
                Value="21" />
    </Style>
</ResourceDictionary>