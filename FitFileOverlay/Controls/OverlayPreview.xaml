<UserControl x:Class="FitFileOverlay.Controls.OverlayPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FitFileOverlay.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              TextBlock.FontSize="14"
              TextBlock.FontWeight="DemiBold">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" 
                        HorizontalAlignment="Left"
                        Margin="5,0">
                <TextBlock Text="{Binding OverlayService.File.FileName, RelativeSource={RelativeSource AncestorType=local:OverlayPreview}}"/>
                <TextBlock Text="{Binding OverlayService.File.LactateThresholdHeartRate, StringFormat={}File LTHR: {0} BPM, RelativeSource={RelativeSource AncestorType=local:OverlayPreview}}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" 
                        HorizontalAlignment="Right"
                        Margin="5,0">
                <TextBlock Text="{Binding OverlayService.File.ActivityDurationString, RelativeSource={RelativeSource AncestorType=local:OverlayPreview}}"
                           HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding OverlayService.File.ActivityDistance, StringFormat={}{0:F2}km, RelativeSource={RelativeSource AncestorType=local:OverlayPreview}}"
                           HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>
        
        <Grid Grid.Row="1">
            <Grid.Background>
                <ImageBrush ImageSource="../Images/white_cross_on_black_background.png"/>
            </Grid.Background>
            <Border BorderBrush="Fuchsia"
                    BorderThickness="3"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Image Source="{Binding SnapshotImage, RelativeSource={RelativeSource AncestorType=local:OverlayPreview}}"/>
            </Border>
        </Grid>
        
        <Slider Grid.Row="2"
                Margin="10" 
                VerticalAlignment="Center" 
                Minimum="0" Maximum="1" 
                IsMoveToPointEnabled="True" 
                Value="{Binding ActivityPercent, RelativeSource={RelativeSource AncestorType=local:OverlayPreview}}"/>
    </Grid>
</UserControl>
