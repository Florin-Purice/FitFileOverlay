<UserControl x:Class="FitFileOverlay.Controls.OverlayPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FitFileOverlay.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8,8,0,0"
                Margin="0,0,0,2"
                Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" 
                            HorizontalAlignment="Left"
                            Margin="5,0">
                    <ui:TextBlock Text="{Binding OverlayService.File.FileName, RelativeSource={RelativeSource AncestorType=local:OverlayPreview}}"
                                  FontTypography="BodyStrong"/>
                    <ui:TextBlock Text="{Binding OverlayService.File.LactateThresholdHeartRate, StringFormat={}File LTHR: {0} BPM, RelativeSource={RelativeSource AncestorType=local:OverlayPreview}}"
                                  FontTypography="BodyStrong"/>
                </StackPanel>
                <StackPanel Grid.Column="2" 
                            HorizontalAlignment="Right"
                            Margin="5,0">
                    <ui:TextBlock Text="{Binding OverlayService.File.ActivityDurationString, RelativeSource={RelativeSource AncestorType=local:OverlayPreview}}"
                                  HorizontalAlignment="Right"
                                  FontTypography="BodyStrong"/>
                    <ui:TextBlock Text="{Binding OverlayService.File.ActivityDistance, StringFormat={}{0:F2}km, RelativeSource={RelativeSource AncestorType=local:OverlayPreview}}"
                                  HorizontalAlignment="Right"
                                  FontTypography="BodyStrong"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1">
            <Border.Background>
                <ImageBrush ImageSource="../Assets/white_cross_on_black_background.png"/>
            </Border.Background>
            <Grid >
                <Border BorderBrush="{DynamicResource AccentTextFillColorTertiaryBrush}"
                        BorderThickness="3"
                        CornerRadius="8"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <Image Source="{Binding SnapshotImage, RelativeSource={RelativeSource AncestorType=local:OverlayPreview}}"/>
            </Border>
        </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="0,0,8,8"
                Margin="0,2,0,0">
            <Slider Margin="10"
                    VerticalAlignment="Center"
                    Minimum="0" Maximum="1"
                    IsMoveToPointEnabled="True"
                    Value="{Binding ActivityPercent, RelativeSource={RelativeSource AncestorType=local:OverlayPreview}}"/>
        </Border>
    </Grid>
</UserControl>
