<UserControl x:Class="FitFileOverlay.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FitFileOverlay.Pages"
             xmlns:custom="clr-namespace:FitFileOverlay.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:HomePageViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="ShowButtonWhenExportingStyle" TargetType="Button">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExportingVideo}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Button Content="Load File"
                    Command="{Binding LoadFileCommand}"/>
            <Button Content="Export Video"
                    Command="{Binding ExportVideoCommand}"/>
            <Button Content="Cancel Export"
                    Style="{StaticResource ShowButtonWhenExportingStyle}"
                    Command="{Binding ExportVideoCancelCommand}"/>
            <TextBlock Text="{Binding ExportVideoProgress}"/>
        </StackPanel>
        <custom:OverlayPreview Grid.Row="1" 
                               OverlayService="{Binding OverlayService}"
                               ActivityPercent="{Binding SnapshotActivityPercent}"/>
    </Grid>
</UserControl>
