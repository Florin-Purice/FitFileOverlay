<Page x:Class="FitFileOverlay.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FitFileOverlay.Pages"
      xmlns:custom="clr-namespace:FitFileOverlay.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="HomePage"
      d:DataContext="{d:DesignInstance local:HomePage, IsDesignTimeCreatable=False}"
      d:DesignHeight="450" d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="ShowButtonWhenExportingStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"> 
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.IsExportingVideo}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button Content="Load file"
                    Margin="0,0,5,0"
                    Command="{Binding ViewModel.LoadFileCommand}"/>
            <Button Content="Export video"
                    Margin="0,0,5,0"
                    Command="{Binding ViewModel.ExportVideoCommand}"/>
            <Button Content="Cancel export"
                    Style="{StaticResource ShowButtonWhenExportingStyle}"
                    Command="{Binding ViewModel.ExportVideoCancelCommand}"/>
            <TextBlock Text="{Binding ViewModel.ExportVideoProgress}"/>
        </StackPanel>
        <custom:OverlayPreview Grid.Row="1" 
                               OverlayService="{Binding ViewModel.OverlayService}"
                               ActivityPercent="{Binding ViewModel.SnapshotActivityPercent}"/>
    </Grid>
</Page>
