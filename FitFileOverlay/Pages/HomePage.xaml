<UserControl x:Class="FitFileOverlay.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FitFileOverlay.Pages"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:HomePageViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
  <Grid>
    <StackPanel>
      <Button Content="Load File"
              Command="{Binding LoadFileCommand}"/>
      <Button Content="Export Video"
              Command="{Binding ExportVideoCommand}"/>
    </StackPanel>
  </Grid>
</UserControl>
