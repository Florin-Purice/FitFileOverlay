<Page x:Class="FitFileOverlay.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:converters="clr-namespace:FitFileOverlay.Converters"
      xmlns:local="clr-namespace:FitFileOverlay.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
      xmlns:enums="clr-namespace:FitFileOverlay.Enums"
      Title="SettingsPage"
      d:DataContext="{d:DesignInstance local:SettingsPage, IsDesignTimeCreatable=False}"
      d:DesignHeight="450"
      d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False"
      mc:Ignorable="d">
    <Page.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <converters:SKColorToColorConverter x:Key="SKColorToColorConverter" />
        <converters:DrawnFieldListToBooleanConverter x:Key="DrawnFieldListToBooleanConverter" />
        <converters:CollectionToVisibilityConverter x:Key="CollectionToVisibilityConverter" />
        <converters:AlphaToColorConverter x:Key="AlphaToColorConverter" />
    </Page.Resources>
    <Grid Margin="20,15,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="Save template"
                           Icon="{ui:SymbolIcon DocumentAdd24}"
                           Margin="0,0,5,0"
                           Command="{Binding ViewModel.SaveTemplateCommand}" />
                <ui:Button Content="Load template"
                           Icon="{ui:SymbolIcon DocumentArrowRight24}"
                           Command="{Binding ViewModel.LoadTemplateCommand}" />
            </StackPanel>
            <ui:Button Grid.Column="1"
                       Content="Preview window"
                       Icon="{ui:SymbolIcon DesktopEdit24}"
                       Command="{Binding ViewModel.OpenPreviewWindowCommand}" />
        </Grid>
        <ui:DynamicScrollViewer Grid.Row="1">
            <StackPanel Margin="0,0,0,15">
                <TextBlock FontSize="20"
                           FontWeight="Medium"
                           Text="Overlay settings" />
                <!--FPS-->
                <ui:CardControl Icon="{ui:SymbolIcon DesktopPulse24}"
                                Margin="0,8,0,0">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="FPS"
                                          TextWrapping="WrapWithOverflow" />
                            <ui:TextBlock Appearance="Secondary"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="Framerate of the output video."
                                          TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:NumberBox Minimum="1"
                                  Maximum="60"
                                  ClearButtonEnabled="False"
                                  Value="{Binding ViewModel.OverlayService.Settings.FPS, UpdateSourceTrigger=PropertyChanged}" />
                </ui:CardControl>
                <!--LTHR-->
                <ui:CardExpander Icon="{ui:SymbolIcon HeartPulse24}"
                                 Margin="0,8,0,0">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Use custom LTHR"
                                          TextWrapping="WrapWithOverflow" />
                            <ui:ToggleSwitch Grid.Column="1"
                                             Margin="0,0,5,0"
                                             LabelPosition="Left"
                                             OnContent="On"
                                             OffContent="Off"
                                             IsChecked="{Binding ViewModel.OverlayService.Settings.UseCustomLTHR}" />
                        </Grid>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="DocumentHeartPulse24" />
                        <ui:TextBlock Grid.Column="1"
                                      FontTypography="BodyStrong"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                      Text="Custom value"
                                      TextWrapping="WrapWithOverflow" />
                        <ui:NumberBox Grid.Column="2"
                                      Minimum="50"
                                      Maximum="300"
                                      ClearButtonEnabled="False"
                                      Value="{Binding ViewModel.OverlayService.Settings.LTHR}" />
                    </Grid>
                </ui:CardExpander>
                <!--Fade duration-->
                <ui:CardControl Icon="{ui:SymbolIcon Clock24}"
                                Margin="0,8,0,0">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Fade duration"
                                          TextWrapping="WrapWithOverflow" />
                            <ui:TextBlock Appearance="Secondary"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="The length of the fading path, in seconds."
                                          TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:NumberBox Minimum="1"
                                  Maximum="10000"
                                  ClearButtonEnabled="False"
                                  Value="{Binding ViewModel.OverlayService.Settings.FadeDurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                </ui:CardControl>
                <!--Colors-->
                <ui:CardControl Icon="{ui:SymbolIcon Color24}"
                                Margin="0,8,0,0">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Background"
                                          TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <colorpicker:PortableColorPicker Style="{StaticResource DefaultColorPickerStyle}"
                                                     Width="50"
                                                     Height="25"
                                                     SelectedColor="{Binding ViewModel.OverlayService.Settings.Background, Converter={StaticResource SKColorToColorConverter}, Mode=TwoWay}" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon Color24}"
                                Margin="0,8,0,0">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Primary color"
                                          TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <colorpicker:PortableColorPicker Style="{StaticResource DefaultColorPickerStyle}"
                                                     Width="50"
                                                     Height="25"
                                                     SelectedColor="{Binding ViewModel.OverlayService.Settings.PrimaryColor, Converter={StaticResource SKColorToColorConverter}, Mode=TwoWay}" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon Color24}"
                                Margin="0,8,0,0">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Secondary color"
                                          TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <colorpicker:PortableColorPicker Style="{StaticResource DefaultColorPickerStyle}"
                                                     Width="50"
                                                     Height="25"
                                                     SelectedColor="{Binding ViewModel.OverlayService.Settings.SecondaryColor, Converter={StaticResource SKColorToColorConverter}, Mode=TwoWay}" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon Color24}"
                                Margin="0,8,0,0">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Tertiary color"
                                          TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <colorpicker:PortableColorPicker Style="{StaticResource DefaultColorPickerStyle}"
                                                     Width="50"
                                                     Height="25"
                                                     SelectedColor="{Binding ViewModel.OverlayService.Settings.TertiaryColor, Converter={StaticResource SKColorToColorConverter}, Mode=TwoWay}" />
                </ui:CardControl>
                <!--Map visibility/dimensions-->
                <ui:CardExpander Icon="{ui:SymbolIcon Map24}"
                                 ContentPadding="0"
                                 Margin="0,8,0,0">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Map"
                                          TextWrapping="WrapWithOverflow" />
                            <ui:ToggleSwitch Grid.Column="1"
                                             Margin="0,0,5,0"
                                             LabelPosition="Left"
                                             OnContent="On"
                                             OffContent="Off"
                                             IsChecked="{Binding ViewModel.OverlayService.Settings.IsGpsOverlayEnabled}" />
                        </Grid>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0"
                              Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="AutoFitWidth24" />
                            <ui:TextBlock Grid.Column="1"
                                          FontTypography="BodyStrong"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Width"
                                          TextWrapping="WrapWithOverflow" />
                            <ui:NumberBox Grid.Column="2"
                                          Minimum="100"
                                          Maximum="3000"
                                          ClearButtonEnabled="False"
                                          Value="{Binding ViewModel.OverlayService.Settings.GpsOverlayWidth, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource ApplicationBackgroundBrush}"
                                BorderThickness="0,0,0,1" />
                        <Grid Grid.Row="2"
                              Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="AutoFitHeight24" />
                            <ui:TextBlock Grid.Column="1"
                                          FontTypography="BodyStrong"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Height"
                                          TextWrapping="WrapWithOverflow" />
                            <ui:NumberBox Grid.Column="2"
                                          Minimum="100"
                                          Maximum="3000"
                                          ClearButtonEnabled="False"
                                          Value="{Binding ViewModel.OverlayService.Settings.GpsOverlayHeight, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Grid>
                </ui:CardExpander>
                <!--Altitude graph visibility/dimensions-->
                <ui:CardExpander Icon="{ui:SymbolIcon DataArea24}"
                                 ContentPadding="0"
                                 Margin="0,8,0,0">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Altitude graph"
                                          TextWrapping="WrapWithOverflow" />
                            <ui:ToggleSwitch Grid.Column="1"
                                             Margin="0,0,5,0"
                                             LabelPosition="Left"
                                             OnContent="On"
                                             OffContent="Off"
                                             IsChecked="{Binding ViewModel.OverlayService.Settings.IsAltitudeOverlayEnabled}" />
                        </Grid>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0"
                              Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="AutoFitWidth24" />
                            <ui:TextBlock Grid.Column="1"
                                          FontTypography="BodyStrong"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Width"
                                          TextWrapping="WrapWithOverflow" />
                            <ui:NumberBox Grid.Column="2"
                                          Minimum="100"
                                          Maximum="5000"
                                          ClearButtonEnabled="False"
                                          Value="{Binding ViewModel.OverlayService.Settings.AltitudeOverlayWidth, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource ApplicationBackgroundBrush}"
                                BorderThickness="0,0,0,1" />
                        <Grid Grid.Row="2"
                              Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="AutoFitHeight24" />
                            <ui:TextBlock Grid.Column="1"
                                          FontTypography="BodyStrong"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Height"
                                          TextWrapping="WrapWithOverflow" />
                            <ui:NumberBox Grid.Column="2"
                                          Minimum="50"
                                          Maximum="3000"
                                          ClearButtonEnabled="False"
                                          Value="{Binding ViewModel.OverlayService.Settings.AltitudeOverlayHeight, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Grid>
                </ui:CardExpander>
                <!--Data fields visibility/dimensions-->
                <ui:CardExpander Icon="{ui:SymbolIcon RowTriple24}"
                                 ContentPadding="0"
                                 Margin="0,8,0,0">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Data fields"
                                          TextWrapping="WrapWithOverflow" />
                            <ui:ToggleSwitch Grid.Column="1"
                                             Margin="0,0,5,0"
                                             LabelPosition="Left"
                                             OnContent="On"
                                             OffContent="Off"
                                             IsChecked="{Binding ViewModel.OverlayService.Settings.IsDataFieldsOverlayEnabled}" />
                        </Grid>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0"
                              Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="AutoFitWidth24" />
                            <ui:TextBlock Grid.Column="1"
                                          FontTypography="BodyStrong"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Width"
                                          TextWrapping="WrapWithOverflow" />
                            <ui:NumberBox Grid.Column="2"
                                          Minimum="100"
                                          Maximum="3000"
                                          ClearButtonEnabled="False"
                                          Value="{Binding ViewModel.OverlayService.Settings.DataFieldsOverlayWidth, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource ApplicationBackgroundBrush}"
                                BorderThickness="0,0,0,1" />
                        <Grid Grid.Row="2"
                              Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="AutoFitHeight24" />
                            <ui:TextBlock Grid.Column="1"
                                          FontTypography="BodyStrong"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Height"
                                          TextWrapping="WrapWithOverflow" />
                            <ui:NumberBox Grid.Column="2"
                                          Minimum="100"
                                          Maximum="3000"
                                          ClearButtonEnabled="False"
                                          Value="{Binding ViewModel.OverlayService.Settings.DataFieldsOverlayHeight, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Grid>
                </ui:CardExpander>

                <TextBlock FontSize="20"
                           FontWeight="Medium"
                           Text="Map specific settings"
                           Margin="0,25,0,0" />
                <!--Line width-->
                <ui:CardControl Icon="{ui:SymbolIcon InkStroke24}"
                                Margin="0,8,0,0">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Line width"
                                          TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:NumberBox Minimum="1"
                                  Maximum="1000"
                                  ClearButtonEnabled="False"
                                  Value="{Binding ViewModel.OverlayService.Settings.GpsLineWidth, UpdateSourceTrigger=PropertyChanged}" />
                </ui:CardControl>

                <TextBlock FontSize="20"
                           FontWeight="Medium"
                           Text="Altitude graph specific settings"
                           Margin="0,25,0,0" />
                <!--Line width-->
                <ui:CardControl Icon="{ui:SymbolIcon InkStroke24}"
                                Margin="0,8,0,0">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Line width"
                                          TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:NumberBox Minimum="1"
                                  Maximum="1000"
                                  ClearButtonEnabled="False"
                                  Value="{Binding ViewModel.OverlayService.Settings.AltitudeLineWidth, UpdateSourceTrigger=PropertyChanged}" />
                </ui:CardControl>
                <!--Bottom padding percent-->
                <ui:CardControl Icon="{ui:SymbolIcon PaddingDown24}"
                                Margin="0,8,0,0">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Bottom padding %"
                                          TextWrapping="WrapWithOverflow" />
                            <ui:TextBlock Appearance="Secondary"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="Distance between lowest point and bottom of graph, percent of total graph height."
                                          TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:NumberBox Minimum="0"
                                  Maximum="100"
                                  ClearButtonEnabled="False"
                                  Value="{Binding ViewModel.OverlayService.Settings.AltitudeBottomPaddingPercent, UpdateSourceTrigger=PropertyChanged}" />
                </ui:CardControl>
                <!--Minimum range-->
                <ui:CardControl Icon="{ui:SymbolIcon TableResizeRow24}"
                                Margin="0,8,0,0">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Minimum range"
                                          TextWrapping="WrapWithOverflow" />
                            <ui:TextBlock Appearance="Secondary"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="Minimum range from minimum to maximum value. If actual range is lower than set range, the graph will appear flatter."
                                          TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:NumberBox Minimum="0"
                                  Maximum="10000"
                                  ClearButtonEnabled="False"
                                  Value="{Binding ViewModel.OverlayService.Settings.AltitudeMinimumRange, UpdateSourceTrigger=PropertyChanged}" />
                </ui:CardControl>
                <!--Background alpha-->
                <ui:CardControl Icon="{ui:SymbolIcon ColorBackground24}"
                                Margin="0,8,0,0">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Background alpha"
                                          TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <colorpicker:AlphaSlider Width="150"
                                             Margin="10"
                                             SelectedColor="{
                        Binding ViewModel.OverlayService.Settings.AltitudeBackgroundAlpha, 
                        Converter={StaticResource AlphaToColorConverter}, 
                        Mode=TwoWay, 
                        UpdateSourceTrigger=PropertyChanged}" />
                </ui:CardControl>
                <!--Altitude text settings-->
                <ui:CardExpander Icon="{ui:SymbolIcon Tag24}"
                                 ContentPadding="0"
                                 Margin="0,8,0,0">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Show current altitude"
                                          TextWrapping="WrapWithOverflow" />
                            <ui:ToggleSwitch Grid.Column="1"
                                             Margin="0,0,5,0"
                                             LabelPosition="Left"
                                             OnContent="Show"
                                             OffContent="Hide"
                                             IsChecked="{Binding ViewModel.OverlayService.Settings.IsAltitudeTextEnabled}" />
                        </Grid>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid  Grid.Row="0"
                               Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="Check24" />
                            <ui:TextBlock Grid.Column="1"
                                          FontTypography="BodyStrong"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Unit"
                                          TextWrapping="WrapWithOverflow" />
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding ViewModel.AltitudeUnits}"
                                      SelectedValue="{Binding ViewModel.OverlayService.Settings.AltitudeUnit}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource ApplicationBackgroundBrush}"
                                BorderThickness="0,0,0,1" />
                        <Grid  Grid.Row="2"
                               Margin="10,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="TextCaseUppercase24" />
                            <ui:TextBlock Grid.Column="1"
                                          FontTypography="BodyStrong"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="Unit capitalization"
                                          TextWrapping="WrapWithOverflow" />
                            <ui:ToggleSwitch Grid.Column="2"
                                             Margin="0,0,5,0"
                                             LabelPosition="Left"
                                             OnContent="Uppercase"
                                             OffContent="Lowercase"
                                             IsChecked="{Binding ViewModel.OverlayService.Settings.UppercaseAltitudeUnit}" />

                        </Grid>
                        <Border Grid.Row="3"
                                BorderBrush="{DynamicResource ApplicationBackgroundBrush}"
                                BorderThickness="0,0,0,1" />
                        <Grid Grid.Row="4"
                              Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="TextFontSize24" />
                            <StackPanel Grid.Column="1">
                                <ui:TextBlock FontTypography="BodyStrong"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                              Text="Unit font size"
                                              TextWrapping="WrapWithOverflow" />
                                <ui:TextBlock Appearance="Secondary"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Text="Font family and style are the same from data fields."
                                              TextWrapping="WrapWithOverflow" />
                            </StackPanel>
                            <ui:NumberBox Grid.Column="2"
                                          Minimum="1"
                                          Maximum="1000"
                                          ClearButtonEnabled="False"
                                          Value="{Binding ViewModel.OverlayService.Settings.AltitudeUnitFontSize, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Border Grid.Row="5"
                                BorderBrush="{DynamicResource ApplicationBackgroundBrush}"
                                BorderThickness="0,0,0,1" />
                        <Grid Grid.Row="6"
                              Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="TextFontSize24" />
                            <StackPanel Grid.Column="1">
                                <ui:TextBlock FontTypography="BodyStrong"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                              Text="Value font size"
