<Page x:Class="FitFileOverlay.Pages.CropPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:FitFileOverlay.Pages"
      xmlns:custom="clr-namespace:FitFileOverlay.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="CropPage"
      d:DataContext="{d:DesignInstance local:CropPage, IsDesignTimeCreatable=False}"
      d:DesignHeight="450"
      d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False"
      mc:Ignorable="d">
    <Grid Margin="20,15,20,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <ui:TextBlock Text="Start"
                              HorizontalAlignment="Center"
                              FontTypography="Subtitle" />
                <ui:NumberBox Margin="0,5,0,0"
                              Value="{Binding ViewModel.OverlayService.CropStartIndex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                              ClearButtonEnabled="False"
                              MinWidth="150" />
            </StackPanel>
            <ui:Button Grid.Column="1"
                       Command="{Binding ViewModel.ResetCropCommand}"
                       Content="Reset"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Icon="{ui:SymbolIcon ArrowReset24}" />
            <StackPanel Grid.Column="2">
                <ui:TextBlock Text="End"
                              HorizontalAlignment="Center"
                              FontTypography="Subtitle" />
                <ui:NumberBox Margin="0,5,0,0"
                              Value="{Binding ViewModel.OverlayService.CropEndIndex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                              ClearButtonEnabled="False"
                              MinWidth="150" />
            </StackPanel>
        </Grid>
        <custom:RangeSlider Grid.Row="1"
                            Margin="10"
                            Height="25"
                            Minimum="0"
                            Maximum="{Binding ViewModel.OverlayService.File.Records.Count}"
                            Start="{Binding ViewModel.OverlayService.CropStartIndex}"
                            End="{Binding ViewModel.OverlayService.CropEndIndex}"
                            StartThumbToolTip="Crop start"
                            EndThumbToolTip="Crop end" />
        <custom:OverlayPreview Grid.Row="2"
                               Grid.Column="0"
                               OverlayService="{Binding ViewModel.OverlayService}"
                               ActivityPercent="{Binding ViewModel.SnapshotActivityPercent}" />
    </Grid>
</Page>
