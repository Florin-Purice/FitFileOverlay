<Window x:Class="FitFileOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pages="clr-namespace:FitFileOverlay.Pages"
        xmlns:local="clr-namespace:FitFileOverlay"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel, IsDesignTimeCreatable=False}"
        Title="Demo App" Height="450" Width="800">
  <Window.Resources>
    <DataTemplate DataType="{x:Type pages:HomePageViewModel}">
      <pages:HomePage/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:SettingsPageViewModel}">
      <pages:SettingsPage/>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <StackPanel>
      <Button Content="Home Page"
              Command="{Binding NavigateToHomeCommand}"/>
      <Button Content="Settings Page"
              Command="{Binding NavigateToSettingsCommand}"/>
    </StackPanel>
    <ContentControl Grid.Column="1" 
                    Content="{Binding NavigationManager.CurrentViewModel}"/>
  </Grid>
</Window>