<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net11.0-windows7.0</TargetFramework>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>app_icon.ico</ApplicationIcon>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Version>2.5.0</Version>
		<AssemblyName>FitFileOverlay</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="app_icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FFMpegCore" Version="6.0.0" />
		<PackageReference Include="FFMpegCore.Extensions.Downloader" Version="6.0.0" />
		<PackageReference Include="FFMpegCore.Extensions.SkiaSharp" Version="6.0.0" />
		<PackageReference Include="Garmin.FIT.Sdk" Version="21.221.0" />
		<PackageReference Include="OpenTK.GLWpfControl" Version="4.3.6" />
		<PackageReference Include="PixiEditor.ColorPicker" Version="3.4.2.3" />
		<PackageReference Include="SkiaSharp.Views.WPF" Version="4.156.1" NoWarn="NU1701" />
		<PackageReference Include="Velopack" Version="1.2.161" />
		<PackageReference Include="WPF-UI" Version="4.3.0" />
		<PackageReference Include="WPF-UI.DependencyInjection" Version="4.3.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Assets\fit_overlay_1024.png" />
		<None Remove="Assets\fit_overlay_256.png" />
		<None Remove="Assets\gray_x_transparent_background.png" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\FitFileOverlay.Core\FitFileOverlay.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\fit_overlay_1024.png" />
		<Resource Include="Assets\fit_overlay_256.png" />
		<Resource Include="Assets\gray_x_transparent_background.png" />
	</ItemGroup>

</Project>
