<Window x:Class="GarminFitFilePaceOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GarminFitFilePaceOverlay"
        mc:Ignorable="d"
        Title="Pace Overlay" Height="800" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <Style x:Key="LthrPanel" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseFileLTHR}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Home"/>
            <Button Grid.Column="2" Content="Settings"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="10">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Button IsEnabled="{Binding IsEnabled}" Click="ProcessFitFileButton_Click">Select FIT File</Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Button IsEnabled="{Binding IsEnabled}" Click="TestButton_Click">Test Change Template</Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Margin="10" IsEnabled="{Binding IsEnabled}" IsChecked="{Binding UseFileLTHR}">Use FIT file lthr</CheckBox>
                    <StackPanel Style="{StaticResource LthrPanel}" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label>LTHR:</Label>
                        <TextBox VerticalContentAlignment="Center" IsEnabled="{Binding IsEnabled}" Text="{Binding CustomLTHR}" Width="100"/>
                    </StackPanel>
                </StackPanel>
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0">FPS</Label>
                    <Slider Grid.Column="1" IsEnabled="{Binding IsEnabled}" VerticalAlignment="Center" Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FPS}"/>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" DockPanel.Dock="Right" Text="{Binding FPS}" Width="30"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Button IsEnabled="{Binding IsEnabled}" Click="ExportButton_Click" Width="Auto">Export Overlay Video</Button>
                </StackPanel>
                <RichTextBox Name="logBox" Height="30" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsReadOnly="True" Background="#FFC2C2C2" FontSize="20">
                    <FlowDocument Name="logFlowDoc"/>
                </RichTextBox>
            </StackPanel>
            <Grid Grid.Row="1" Background="Black">
                <Image Name="snapshotImage"/>
            </Grid>
            <Slider Margin="10" Grid.Row="2" IsEnabled="{Binding IsEnabled}" VerticalAlignment="Center" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" Value="{Binding SnapshotActivityPercent}"/>
        </Grid>
    </Grid>
</Window>
