<Window x:Class="GarminFitFilePaceOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GarminFitFilePaceOverlay" 
        xmlns:pages="clr-namespace:GarminFitFilePaceOverlay.Pages"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel}"
        Title="Pace Overlay" Height="800" Width="800">
    <Window.Resources>
        <DataTemplate DataType="{x:Type pages:HomePageViewModel}">
            <pages:HomePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:SettingsPageViewModel}">
            <pages:SettingsPage/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <ContentControl Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
