<UserControl x:Class="GarminFitFilePaceOverlay.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GarminFitFilePaceOverlay.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <local:SettingsPageViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <Style x:Key="LthrPanel" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseFileLTHR}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <StackPanel Margin="10">
            <StackPanel Orientation="Horizontal">
                <CheckBox Margin="10" IsChecked="{Binding UseFileLTHR}">Use FIT file lthr</CheckBox>
                <StackPanel Style="{StaticResource LthrPanel}" Orientation="Horizontal" VerticalAlignment="Center">
                    <Label>LTHR:</Label>
                    <TextBox VerticalContentAlignment="Center" Text="{Binding CustomLTHR}" Width="100"/>
                </StackPanel>
            </StackPanel>
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0">FPS</Label>
                <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FPS}"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" DockPanel.Dock="Right" Text="{Binding FPS}" Width="30"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
