<UserControl x:Class="GarminFitFilePaceOverlay.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GarminFitFilePaceOverlay.Pages"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:HomePageViewModel}"
             d:DesignHeight="450" d:DesignWidth="800" d:Background="AliceBlue">
    <UserControl.Resources>
        <Style x:Key="ShowButtonWhenBusyStyle" TargetType="Button">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExportingVideo}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="10">
                        <Button Command="{Binding LoadFileCommand}" Content="Load FIT File"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10">
                        <Button Width="Auto" Command="{Binding ExportVideoCommand}" Content="Export Overlay Video"/>
                        <Button Style="{StaticResource ShowButtonWhenBusyStyle}" Command="{Binding ExportVideoCancelCommand}" Content="Cancel Export"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Button IsEnabled="{Binding IsNotBusy}" Command="{Binding NavigateToSettingsPageCommand}" Content="Settings"/>
                </StackPanel>
            </Grid>
            <RichTextBox Name="logBox" Height="30" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsReadOnly="True" Background="#FFC2C2C2" FontSize="20">
                <FlowDocument>
                    <Paragraph>
                        <Run Text="{Binding LogText}" Foreground="{Binding LogTextColor}"/>
                    </Paragraph>
                </FlowDocument>
            </RichTextBox>
        </StackPanel>
        <Grid Grid.Row="1" Background="Black">
            <Image Source="{Binding SnapshotImage}"/>
        </Grid>
        <Slider Margin="10" Grid.Row="2" IsEnabled="{Binding IsNotBusy}" VerticalAlignment="Center" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" Value="{Binding SnapshotActivityPercent}"/>
    </Grid>
</UserControl>
