<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:s="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <s:Boolean x:Key="UseFileLTHR">True</s:Boolean>
    <s:Boolean x:Key="IsPrimaryOverlay">True</s:Boolean>
    <s:Int32 x:Key="CustomLTHR">145</s:Int32>
    <s:UInt32 x:Key="FPS">5</s:UInt32>
    <s:String x:Key="PaceLabel">Pace</s:String>
    <s:String x:Key="PaceUnit">/KM</s:String>
    <s:String x:Key="HrLabel">Heart Rate</s:String>
    <s:String x:Key="HrUnit">BPM</s:String>
    <s:String x:Key="DistanceLabel">Distance</s:String>
    <s:String x:Key="DistanceUnit">KM</s:String>
</ResourceDictionary>